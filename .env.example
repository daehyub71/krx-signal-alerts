# 값을 채워 .env로 복사한다. .env는 절대 커밋하지 않는다.

# ── Supabase (krx-stock-charts와 같은 프로젝트) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=

# ── 카카오 나에게 보내기 ──
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/callback

# ── Gmail SMTP (계정 비밀번호가 아니라 앱 비밀번호) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=

# ── 웹 링크 (알림 본문 하단) ──
SIGNALS_WEB_URL=

# 값을 채워 .env로 복사한다. .env는 절대 커밋하지 않는다.

# ── Supabase (krx-stock-charts와 같은 프로젝트) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=

# ── 카카오 나에게 보내기 ──
# 리다이렉트 URI는 앱 설정 > 플랫폼 키 > REST API 키에 등록한다 (카카오 로그인 메뉴가 아니다)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/callback
# 최초 1회 scripts/kakao_auth.py가 채운다. 약 2개월마다 갱신되며 끊기면 재인증해야 한다.
KAKAO_REFRESH_TOKEN=

# ── Gmail SMTP (계정 비밀번호가 아니라 앱 비밀번호) ──
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 수신자 — 쉼표로 여러 명을 넣을 수 있다
RECIPIENTS=

# ── 웹 링크 (알림 본문 하단) ──
SIGNALS_WEB_URL=
